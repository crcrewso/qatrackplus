POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=qatrackplus
USE_DOCKER=true

# Add the hostname or IP address you will use to access QATrack+ here,
# comma-separated. A wildcard (*) accepts any Host header and is not safe
# for a real deployment.
ALLOWED_HOSTS=localhost,127.0.0.1

# Required for Django 4.0+ or logins/forms behind a reverse proxy will fail
# with "CSRF verification failed". Must include the scheme (http/https).
# If left unset, it's derived from ALLOWED_HOSTS above (both schemes, "*" skipped).
# For example: CSRF_TRUSTED_ORIGINS=https://my-server,http://my-server
# CSRF_TRUSTED_ORIGINS=

# Time zone for this installation. Choices can be found here:
# http://en.wikipedia.org/wiki/List_of_tz_zones_by_name
TIME_ZONE=America/Toronto

# Backup retention (see the `backup` service in compose.yaml, and
# deploy/docker/backup/backup.sh). Matches the tiered daily/weekly/monthly
# scheme used by qatrack_core's backup_site command for non-Docker
# deployments - a daily backup is always kept for BACKUP_DAYS_TO_KEEP days;
# additionally, on day-of-week BACKUP_WEEKLY_DAY (0=Monday..6=Sunday) a
# weekly backup is also kept for BACKUP_WEEKS_TO_KEEP weeks, and on
# day-of-month BACKUP_MONTHLY_DAY a monthly backup is also kept for
# BACKUP_MONTHS_TO_KEEP months. These all have working defaults (matching
# backup_site's own) if left unset.
# BACKUP_DAYS_TO_KEEP=7
# BACKUP_WEEKS_TO_KEEP=5
# BACKUP_MONTHS_TO_KEEP=12
# BACKUP_WEEKLY_DAY=2
# BACKUP_MONTHLY_DAY=3
