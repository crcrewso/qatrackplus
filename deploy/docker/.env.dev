# Local development convenience defaults for running the Docker stack -
# copy this file to deploy/docker/.env (or docker compose --env-file it).
# Do NOT use this for a real deployment: the password below is a known,
# documented convenience value (matching the shared example password used
# in the postgres/mysql install guides), not a secret, and ALLOWED_HOSTS=*
# accepts any Host header.
#
# Note this only affects database credentials and host checking - unlike
# deploy/dev/local_settings.dev.py for non-Docker installs, this does NOT
# enable Django's DEBUG mode: settings.py's use_docker branch hardcodes
# DEBUG = False unconditionally, so the Docker path is always
# production-shaped regardless of this file.
POSTGRES_USER=qatrack
POSTGRES_PASSWORD=qatrackpass
POSTGRES_DB=qatrackplus
USE_DOCKER=true

# Permissive for local development only - see deploy/docker/.env.example
# for the safer production default and why it matters.
ALLOWED_HOSTS=*

TIME_ZONE=America/Toronto
